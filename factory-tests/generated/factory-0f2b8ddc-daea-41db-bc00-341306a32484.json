        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode",
        "exact": true
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "button[aria-label=\"Switch to light mode\"]:focus-visible"
      }
    },
    {
      "type": "press",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode",
        "exact": true
      },
      "key": "Space"
