{
  "name": "Service Catalog left-side dark mode toggle",
  "criteria": [
    "The existing theme toggle is visible on the left side without a duplicate control.",
    "Selecting the toggle changes the application theme and its accessible state.",
    "The selected dark theme remains active after a page refresh.",
    "The toggle exposes a meaningful accessible button label.",
    "The toggle supports Enter and Space keyboard activation with visible focus styling.",
    "The Service Catalog remains loaded and its available navigation remains usable."
  ],
  "steps": [
    {
      "type": "goto",
      "path": "/"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "button.left-6"
      }
    },
    {
      "type": "expectAttribute",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode"
      },
      "attribute": "aria-label",
      "expected": "Switch to dark mode"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "link",
        "name": "Admin"
      }
    },
    {
      "type": "screenshot",
      "name": "service-catalog-theme-toggle-left"
    },
    {
      "type": "click",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode"
      }
    },
    {
      "type": "expectAttribute",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode"
      },
      "attribute": "aria-label",
      "expected": "Switch to light mode"
    },
    {
      "type": "reload"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode"
      }
    },
    {
      "type": "press",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode"
      },
      "key": "Enter"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "button.left-6:focus-visible"
      }
    },
    {
      "type": "expectHidden",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode"
      }
    },
    {
      "type": "press",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode"
      },
      "key": "Space"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "button.left-6:focus-visible"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode"
      }
    },
    {
      "type": "click",
      "locator": {
        "kind": "role",
        "role": "link",
        "name": "Admin"
      }
    },
    {
      "type": "goto",
      "path": "/"
    },
    {
      "type": "expectText",
      "locator": {
        "kind": "text",
        "value": "Find the right service for your needs"
      },
      "value": "Find the right service for your needs"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Showing"
      }
    }
  ]
}
