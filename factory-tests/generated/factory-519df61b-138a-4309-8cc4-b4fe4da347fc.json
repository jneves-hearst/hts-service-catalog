{
  "name": "Service Catalog dark mode toggle placement and behavior",
  "criteria": [
    "The existing dark mode toggle is visible on the left side of the Service Catalog.",
    "Selecting the toggle changes the application theme.",
    "The selected theme persists after a full page refresh.",
    "The theme control has an accessible label identifying its current action.",
    "The theme control supports keyboard activation.",
    "Existing Service Catalog functionality continues to render and respond to a catalog filter interaction.",
    "The existing theme control remains operable without introducing a second control."
  ],
  "steps": [
    {
      "type": "goto",
      "path": "/"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode",
        "exact": true
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": ".left-6"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Find the right service for your needs"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Showing"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "All",
        "exact": true
      }
    },
    {
      "type": "click",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "All",
        "exact": true
      }
    },
    {
      "type": "expectText",
      "locator": {
        "kind": "text",
        "value": "Showing"
