{
  "name": "Service Catalog dark mode toggle placement and behavior",
  "criteria": [
    "The single dark mode toggle is visible on the left side of the Service Catalog.",
    "Activating the toggle changes the application theme.",
    "The selected dark theme persists after a full page refresh.",
    "The toggle exposes an accessible label describing the available theme action.",
    "The toggle supports keyboard activation.",
    "The existing Service Catalog content continues to render after theme changes and refreshes.",
    "The existing toggle remains operable without introducing a second control."
  ],
  "steps": [
    {
      "type": "goto",
      "path": "/"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode",
        "exact": true
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": ".left-6"
      }
    },
    {
      "type": "expectHidden",
      "locator": {
        "kind": "css",
        "value": ".right-6"
      }
    },
    {
      "type": "expectHidden",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Find the right service for your needs"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Showing"
      }
    },
    {
      "type": "screenshot",
      "name": "light-theme-toggle-on-left"
    },
    {
      "type": "click",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode",
        "exact": true
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode",
        "exact": true
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": ".left-6"
      }
    },
    {
      "type": "expectHidden",
      "locator": {
        "kind": "css",
        "value": ".right-6"
      }
    },
    {
      "type": "screenshot",
      "name": "dark-theme-toggle-on-left"
    },
    {
      "type": "reload"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode",
        "exact": true
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "expectText",
      "locator": {
        "kind": "text",
        "value": "Find the right service for your needs"
      },
      "value": "Find the right service for your needs"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Showing"
      }
    },
    {
      "type": "press",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode",
        "exact": true
      },
      "key": "Enter"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode",
        "exact": true
      }
    },
    {
      "type": "expectHidden",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "reload"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode",
        "exact": true
      }
    },
    {
      "type": "expectHidden",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "expectText",
      "locator": {
        "kind": "text",
        "value": "Find the right service for your needs"
      },
      "value": "Find the right service for your needs"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Showing"
      }
    },
    {
      "type": "screenshot",
      "name": "keyboard-activated-light-theme"
    }
  ]
}
