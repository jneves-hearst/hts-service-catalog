{
  "name": "Service Catalog dark mode toggle relocation and regression coverage",
  "criteria": [
    "The dark mode toggle is visibly positioned on the left side of the application.",
    "Selecting the toggle changes the application theme and rendered theme state.",
    "The selected dark theme persists after a page refresh.",
    "The toggle has a meaningful accessible label.",
    "The toggle supports keyboard activation with Enter and Space.",
    "Existing catalog search functionality remains usable after the toggle relocation."
  ],
  "steps": [
    {
      "type": "goto",
      "path": "/"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "button.fixed.left-6"
      }
    },
    {
      "type": "screenshot",
      "name": "dark-toggle-left-light-theme"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode"
      }
    },
    {
      "type": "click",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode"
      }
    },
    {
      "type": "screenshot",
      "name": "dark-toggle-left-dark-theme"
    },
    {
      "type": "reload"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode"
      }
    },
    {
      "type": "press",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode"
      },
      "key": "Enter"
    },
    {
      "type": "expectHidden",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode"
      }
    },
    {
      "type": "press",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode"
      },
      "key": "Space"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode"
      }
    },
    {
      "type": "fill",
      "locator": {
        "kind": "placeholder",
        "value": "Search services by name, category, or keyword…"
      },
      "value": "security"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Showing"
      }
    },
    {
      "type": "screenshot",
      "name": "catalog-search-after-theme-relocation"
    }
  ]
}
