{
  "name": "Service Catalog dark mode toggle left-side behavior",
  "criteria": [
    "The existing dark mode toggle is visible on the left side without obscuring the catalog.",
    "Selecting the toggle changes the application theme and updates its accessible state.",
    "The selected dark theme persists after refresh and a subsequent page load.",
    "The toggle has an accessible label.",
    "The toggle supports keyboard activation with native button behavior.",
    "Existing catalog content and search functionality remain available before and after changing the theme."
  ],
  "steps": [
    {
      "type": "goto",
      "path": "/"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Find the right service for your needs",
        "exact": true
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode",
        "exact": true
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "button.left-6"
      }
    },
    {
      "type": "expectAttribute",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode",
        "exact": true
      },
      "attribute": "aria-label",
      "expected": "Switch to dark mode"
    },
    {
      "type": "screenshot",
      "name": "light-theme-toggle-on-left"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "input[placeholder*=\"Search\"]"
      }
    },
    {
      "type": "fill",
      "locator": {
        "kind": "css",
        "value": "input[placeholder*=\"Search\"]"
      },
      "value": "service"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Showing"
      }
    },
    {
      "type": "click",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode",
        "exact": true
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode",
        "exact": true
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "screenshot",
      "name": "dark-theme-toggle-on-left"
    },
    {
      "type": "reload"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode",
        "exact": true
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "goto",
      "path": "/"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode",
        "exact": true
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "press",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode",
        "exact": true
      },
      "key": "Enter"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode",
        "exact": true
      }
    },
    {
      "type": "expectHidden",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode",
        "exact": true
      }
    },
    {
      "type": "press",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode",
        "exact": true
      },
      "key": "Space"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode",
        "exact": true
      }
    },
    {
      "type": "expectHidden",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "fill",
      "locator": {
        "kind": "css",
        "value": "input[placeholder*=\"Search\"]"
      },
      "value": "service"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Showing"
      }
    },
    {
      "type": "screenshot",
      "name": "catalog-search-after-theme-change"
    }
  ]
}
