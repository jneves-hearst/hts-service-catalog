{
  "name": "Service Catalog dark mode toggle left placement and behavior",
  "criteria": [
    "The dark mode toggle is visible on the left side of the Service Catalog.",
    "Activating the toggle changes the document theme and accessible action label.",
    "The selected dark theme persists after a full page refresh.",
    "The theme control has a non-empty accessible label describing its current action.",
    "The theme control activates from the keyboard and retains a visible focus state.",
    "Existing catalog search and service-count functionality remain available before and after theme changes.",
    "The Service Catalog loads successfully with its expected title and catalog content after the layout change.",
    "The change is limited to the approved theme-toggle application source and generated QA coverage."
  ],
  "steps": [
    {
      "type": "goto",
      "path": "/"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Find the right service for your needs",
        "exact": true
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": ".left-6"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode",
        "exact": true
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "input"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Showing",
        "exact": false
      }
    },
    {
      "type": "screenshot",
      "name": "service-catalog-left-toggle-light"
    },
    {
      "type": "fill",
      "locator": {
        "kind": "css",
        "value": "input"
      },
      "value": "security"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Showing",
        "exact": false
      }
    },
    {
      "type": "click",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode",
        "exact": true
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode",
        "exact": true
      }
    },
    {
      "type": "expectAttribute",
      "locator": {
        "kind": "css",
        "value": "html"
      },
      "attribute": "class",
      "expected": "h-full antialiased dark"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Find the right service for your needs",
        "exact": true
      }
    },
    {
      "type": "screenshot",
      "name": "service-catalog-left-toggle-dark"
    },
    {
      "type": "reload"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode",
        "exact": true
      }
    },
    {
      "type": "expectAttribute",
      "locator": {
        "kind": "css",
        "value": "html"
      },
      "attribute": "class",
      "expected": "h-full antialiased dark"
    },
    {
      "type": "press",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode",
        "exact": true
      },
      "key": "Enter"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "button:focus-visible"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode",
        "exact": true
      }
    },
    {
      "type": "expectAttribute",
      "locator": {
        "kind": "css",
        "value": "html"
      },
      "attribute": "class",
      "expected": "h-full antialiased"
    },
    {
      "type": "fill",
      "locator": {
        "kind": "css",
        "value": "input"
      },
      "value": "data"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Showing",
        "exact": false
      }
    },
    {
      "type": "screenshot",
      "name": "service-catalog-keyboard-light"
    }
  ]
}
