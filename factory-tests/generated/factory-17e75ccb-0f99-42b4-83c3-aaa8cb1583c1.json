{
  "name": "Service Catalog dark mode toggle and catalog regression",
  "criteria": [
    "The dark mode toggle is visible on the left side without a duplicate right-side toggle.",
    "Selecting the toggle changes the application theme and its accessible state label.",
    "The selected theme persists after a page refresh.",
    "The toggle exposes a meaningful accessible label.",
    "The toggle supports keyboard activation and retains visible keyboard focus.",
    "The Service Catalog continues to render and supports search and selecting a catalog item after theme changes and refreshes."
  ],
  "steps": [
    {
      "type": "goto",
      "path": "/"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Find the right service for your needs"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Showing"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "button.left-6"
      }
    },
    {
      "type": "expectHidden",
      "locator": {
        "kind": "css",
        "value": "button.right-6"
      }
    },
    {
      "type": "screenshot",
      "name": "service-catalog-light-left-toggle"
    },
    {
      "type": "click",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "screenshot",
      "name": "service-catalog-dark-left-toggle"
    },
    {
      "type": "reload"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Find the right service for your needs"
      }
    },
    {
      "type": "press",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode"
      },
      "key": "Space"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "button.left-6:focus-visible"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode"
      }
    },
    {
      "type": "expectHidden",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "reload"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode"
      }
    },
    {
      "type": "expectHidden",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "main input"
      }
    },
    {
      "type": "fill",
      "locator": {
        "kind": "css",
        "value": "main input"
      },
      "value": "security"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Showing"
      }
    },
    {
      "type": "screenshot",
      "name": "service-catalog-search-regression"
    },
    {
      "type": "reload"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Showing"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "main > div > div:nth-child(3) > *:first-child"
      }
    },
    {
      "type": "expectHidden",
      "locator": {
        "kind": "css",
        "value": "main > div > div:nth-child(4) > *"
      }
    },
    {
      "type": "click",
      "locator": {
        "kind": "css",
        "value": "main > div > div:nth-child(3) > *:first-child"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "main > div > div:nth-child(4) > *"
      }
    },
    {
      "type": "screenshot",
      "name": "service-catalog-item-detail-regression"
    },
    {
      "type": "reload"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Find the right service for your needs"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Showing"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode"
      }
    }
  ]
}
