{
  "name": "Service Catalog left-side dark mode toggle",
  "criteria": [
    "The theme toggle is visible on the left side of the Service Catalog and remains positioned there across the supported layout.",
    "Activating the toggle changes the document theme and visible toggle state.",
    "The selected dark theme persists after a page refresh.",
    "The toggle has an accessible button name and exposes its current state.",
    "The toggle supports keyboard activation with Enter and Space, with a visible focus treatment captured in screenshots.",
    "Existing Service Catalog content and search functionality remain available after the layout change."
  ],
  "steps": [
    {
      "type": "goto",
      "path": "/"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Find the right service for your needs"
      }
    },
    {
      "type": "expectHidden",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode"
      }
    },
    {
      "type": "expectAttribute",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode"
      },
      "attribute": "aria-pressed",
      "expected": "false"
    },
    {
      "type": "expectAttribute",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode"
      },
      "attribute": "class",
      "expected": "left-6"
    },
    {
      "type": "screenshot",
      "name": "catalog-light-theme-left-toggle"
    },
    {
      "type": "click",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode"
      }
    },
    {
      "type": "expectAttribute",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode"
      },
      "attribute": "aria-pressed",
      "expected": "true"
    },
    {
      "type": "screenshot",
      "name": "catalog-dark-theme-left-toggle"
    },
    {
      "type": "reload"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode"
      }
    },
    {
      "type": "expectAttribute",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode"
      },
      "attribute": "aria-pressed",
      "expected": "true"
    },
    {
      "type": "press",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode"
      },
      "key": "Enter"
    },
    {
      "type": "expectHidden",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode"
      }
    },
    {
      "type": "expectAttribute",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode"
      },
      "attribute": "aria-pressed",
      "expected": "false"
    },
    {
      "type": "screenshot",
      "name": "catalog-enter-keyboard-focus"
    },
    {
      "type": "press",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode"
      },
      "key": "Space"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode"
      }
    },
    {
      "type": "expectAttribute",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode"
      },
      "attribute": "aria-pressed",
      "expected": "true"
    },
    {
      "type": "screenshot",
      "name": "catalog-space-keyboard-focus"
    },
    {
      "type": "fill",
      "locator": {
        "kind": "css",
        "value": "input"
      },
      "value": "security"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Showing"
      }
    }
  ]
}
