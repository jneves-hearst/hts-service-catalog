{
  "name": "Service Catalog left-side dark mode regression",
  "criteria": [
    "AC1: The theme toggle is visible and uses the left-side positioning class; the placement is also captured visually.",
    "AC2: Activating the toggle changes its accessible action label and enables the html.dark theme marker.",
    "AC3: The dark theme remains selected after a page reload.",
    "AC4: The toggle is exposed as a button with a non-empty accessible name describing the available theme action.",
    "AC5: Enter and Space activate the toggle, preserve visible focus, and produce the expected theme and accessible-label changes.",
    "AC6: Catalog heading and service-count content render in both the initial light theme and the alternate dark theme.",
    "AC7: The complete page smoke flow renders successfully through the theme and catalog checks."
  ],
  "steps": [
    {
      "type": "goto",
      "path": "/"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Find the right service for your needs",
        "exact": true
      }
    },
    {
      "type": "expectText",
      "locator": {
        "kind": "text",
        "value": "Find the right service for your needs",
        "exact": true
      },
      "value": "Find the right service for your needs"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Showing"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "testId",
        "value": "theme-toggle"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "[data-testid=\"theme-toggle\"].left-6"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode",
        "exact": true
      }
    },
    {
      "type": "expectHidden",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "screenshot",
      "name": "light-theme-left-toggle"
    },
    {
      "type": "click",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode",
        "exact": true
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode",
        "exact": true
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Find the right service for your needs",
        "exact": true
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Showing"
      }
    },
    {
      "type": "screenshot",
      "name": "dark-theme-left-toggle"
    },
    {
      "type": "reload"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode",
        "exact": true
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "screenshot",
      "name": "dark-theme-persisted-after-reload"
    },
    {
      "type": "press",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode",
        "exact": true
      },
      "key": "Enter"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "[data-testid=\"theme-toggle\"]:focus-visible"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode",
        "exact": true
      }
    },
    {
      "type": "expectHidden",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "press",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to dark mode",
        "exact": true
      },
      "key": "Space"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "[data-testid=\"theme-toggle\"]:focus-visible"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Switch to light mode",
        "exact": true
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "css",
        "value": "html.dark"
      }
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Find the right service for your needs",
        "exact": true
      }
    },
    {
      "type": "expectText",
      "locator": {
        "kind": "text",
        "value": "Find the right service for your needs",
        "exact": true
      },
      "value": "Find the right service for your needs"
    },
    {
      "type": "expectVisible",
      "locator": {
        "kind": "text",
        "value": "Showing"
      }
    },
    {
      "type": "screenshot",
      "name": "keyboard-theme-and-catalog-regression"
    }
  ]
}
